# =============================================================================
# dot – configuration template
# Skopiuj do .env i uzupełnij:
#   cp .env.example .env
# =============================================================================

# --- Podstawowe ---
PORT=3250
FRONT_PORT=5173
PUBLIC_ORIGIN=http://localhost:3250

# --- Multi-machine / współdzielony stan ---
# Włącz globalny rate-limit + współdzielony cache renderowania (Redis/Valkey).
# Postaw Redis lokalnie:  sudo ./tools/setup_redis.sh
REDIS_URL=
VALKEY_URL=

# Proces-safe baza dla galerii i static links (SQLite). Brak = pliki JSON.
# DOT_DB_PATH=/var/www/dot/dot.db

# Lista zaufanych proxy (CIDR), z których ufa się X-Forwarded-For.
TRUSTED_PROXIES=

# --- Monetyzacja / API keys ---
# Płatne klucze API (rozdzielone przecinkami), akceptowane jako
# "Authorization: Bearer <key>".
DOT_API_KEYS=
DOT_BATCH_PAID_LIMIT=1000
DOT_BATCH_FREE_LIMIT=30
DOT_LINKS_FREE_QUOTA=5

# Tymczasowo wyłącza enforcement limitów (batch + static links) dla wszystkich.
# Ustaw "1" aby każdy korzystał bez limitów. Kod limitów pozostaje aktywny.
DOT_DISABLE_LIMITS=1
